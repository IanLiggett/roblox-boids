--!strict
local UnitTest = require(script.Parent.Parent.RunUnitTest)

return function(t: UnitTest.Context): ()
	local client = (game:GetService("StarterPlayer").StarterPlayerScripts:WaitForChild("BoidsClient") :: Instance)
		:: typeof(game.ServerScriptService.BoidsSystem.BoidsClient)
	local visibility = require(client.BoidsRenderer.Visibility)
	local measurements = require(client.BoidsRenderer.Measurements)

	t.test("network distance changes opacity only at the boundary", function()
		t.expect.equal(visibility.DistanceOpacity(0, 512), 1)
		t.expect.near(visibility.DistanceOpacity(409.6, 512), 1)
		t.expect.equal(visibility.DistanceOpacity(460.8, 512), 1)
		t.expect.equal(visibility.DistanceOpacity(511.99, 512), 1)
		t.expect.equal(visibility.DistanceOpacity(512, 512), 0)
		t.expect.equal(visibility.DistanceOpacity(1000, 512), 0)
	end)

	t.test("view accounts for aspect ratio, sphere extent and a conservative margin", function()
		local wide = visibility.CreateView(CFrame.identity, 60, Vector2.new(2000, 1000))
		local tall = visibility.CreateView(CFrame.identity, 60, Vector2.new(1000, 2000))
		t.expect.truthy(visibility.IsInView(Vector3.new(100, 0, -100), 1, wide))
		t.expect.falsy(visibility.IsInView(Vector3.new(100, 0, -100), 1, tall))
		t.expect.falsy(visibility.IsInView(Vector3.new(0, 0, 100), 1, wide))
		t.expect.truthy(visibility.IsInView(Vector3.zero, 10, wide))
		t.expect.truthy(visibility.IsInView(Vector3.new(0, 75, -100), 10, wide))
		t.expect.falsy(visibility.IsInView(Vector3.new(0, 100, -100), 1, wide))
	end)

	t.test("hidden cells need no pass and entry is immediately opaque", function()
		local state = visibility.New()
		t.expect.falsy(visibility.NeedsPass(state))
		t.expect.truthy(visibility.SetTarget(state, 1))
		visibility.BeginPass(state)
		t.expect.equal(state.passOpacity, 1)
		visibility.CompletePass(state)
		t.expect.equal(state.targetOpacity, 1)
		t.expect.falsy(visibility.SetTarget(state, 1))
	end)

	t.test("membership passes capture binary opacity", function()
		local state = visibility.New()
		visibility.SetTarget(state, 1)
		visibility.BeginPass(state)
		visibility.SetTarget(state, 0)
		t.expect.equal(state.passOpacity, 1)
		visibility.CompletePass(state)
		t.expect.equal(state.appliedOpacity, 1)
		t.expect.truthy(visibility.NeedsPass(state))
	end)

	t.test("hiding completes once and reversals are immediately opaque", function()
		local state = visibility.New()
		visibility.SetTarget(state, 1)
		visibility.BeginPass(state)
		visibility.CompletePass(state)
		t.expect.truthy(visibility.SetTarget(state, 0))
		t.expect.truthy(visibility.NeedsPass(state))
		visibility.BeginPass(state)
		visibility.CompletePass(state)
		t.expect.falsy(visibility.NeedsPass(state))
		visibility.SetTarget(state, 0)
		t.expect.falsy(visibility.NeedsPass(state))
		visibility.SetTarget(state, 1)
		t.expect.equal(state.targetOpacity, 1)
	end)

	t.test("a visible migrant invalidates a hidden cell for one hide pass", function()
		local state = visibility.New()
		state.appliedOpacity = -1
		t.expect.truthy(visibility.NeedsPass(state))
		visibility.BeginPass(state)
		visibility.CompletePass(state)
		t.expect.falsy(visibility.NeedsPass(state))
	end)

	t.test("measurements distinguish motion from budgeted visibility writes", function()
		measurements.Reset()
		measurements.SetEnabled(true)
		measurements.Record(1, 0.016, 10, 2, 100, 0, 100, 0, 0, 100, 8, 2, 100)
		local result = measurements.Read()
		t.expect.equal(result.motionUpdatesTotal, 0)
		t.expect.equal(result.transparencyWritesTotal, 100)
		t.expect.equal(result.hiddenCells, 8)
		t.expect.equal(result.transparencyWritesMax, 100)
		measurements.SetEnabled(false)
		measurements.Reset()
	end)
end
