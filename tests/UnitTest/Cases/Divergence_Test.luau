--!strict
local UnitTest = require(script.Parent.Parent.RunUnitTest)
return function(t: UnitTest.Context): ()
 local package = (game.ReplicatedStorage:WaitForChild("BoidsReplicated") :: Instance)
  :: typeof(game.ServerScriptService.BoidsSystem.BoidsReplicated)
 local Aggregate = require(package.CorrectionDivergence)
 local Divergence = require(package.Testing.PerformanceTelemetry.Divergence)
 t.test("worker divergence time-aligns without a correction cache or raw sample lists", function()
  local sample = Aggregate.New()
  Aggregate.Observe(sample, Vector3.new(4,0,0), Vector3.new(3,0,0), Vector3.zero, Vector3.xAxis, 9, 10)
  local result = assert(Divergence.Read(sample))
  t.expect.equal(result.sampleCount, 1)
  t.expect.equal(result.positionRmse, 3)
  t.expect.equal(result.velocityRmse, 2)
  t.expect.equal(result.maxPositionError, 3)
  t.expect.equal(result.positionAverage, 3)
  t.expect.equal(result.positionStandardDeviation, 0)
  t.expect.equal(result.positionMedian, nil)
  t.expect.equal(result.sampling, "worker-jobs")
 end)
 t.test("divergence excludes future, stale and default targets", function()
  local sample = Aggregate.New()
  for _,time in {11,6,0} do Aggregate.Observe(sample, Vector3.zero, Vector3.zero, Vector3.zero, Vector3.zero, time, 10) end
  t.expect.equal(Divergence.Read(sample), nil)
 end)
end
