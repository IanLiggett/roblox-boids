return function(sourceOverride: string?): string
 if not sourceOverride then
  assert(not game:GetService("RunService"):IsRunning(), "Prepare scheduler fixture before Play")
 end
 local source = sourceOverride or game.ServerScriptService.BoidsSystem.BoidsReplicated.Boids.JobBuilder.Source
 local first = assert((source:find("local MAX_SEEN =", 1, true)), "Dispatch slice start changed")
 local last = assert((source:find("local function collectStats", first, true)), "Dispatch slice end changed")
 local generated = prelude .. source:sub(first, last - 1) .. exports
 if sourceOverride then return generated end

 local folder = script.Parent.Fixtures
 local existing: ModuleScript? = folder:FindFirstChild("SchedulerDispatch") :: ModuleScript?
 local fixture: ModuleScript
 if not existing then
  fixture = Instance.new("ModuleScript")
  fixture.Name = "SchedulerDispatch"
  fixture.Parent = folder
 else
  fixture = existing
  assert(fixture:GetAttribute("GeneratedSchedulerFixture") == true, "Do not overwrite a hand-edited fixture")
 end
 fixture.Source = generated
 fixture:SetAttribute("GeneratedSchedulerFixture", true)
 return fixture:GetFullName()
end
